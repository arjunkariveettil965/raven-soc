RAVEN_API_DB_PATH=database/raven_soc_api.db
RAVEN_API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
RAVEN_API_ENV=development
RAVEN_API_REPOSITORY=sqlite
RAVEN_API_HOST=0.0.0.0
PORT=8000
RAVEN_OLLAMA_URL=http://localhost:11434
RAVEN_OLLAMA_MODEL=gemma3:4b-it-qat

# Frontend (Vite) — set in Azure Static Web Apps / CI build environment
VITE_API_URL=https://<your-backend-host>/api/v1
# Optional local dev proxy target when using `npm run dev` (defaults to http://127.0.0.1:8000)
VITE_DEV_API_PROXY=http://127.0.0.1:8000
# Set true only for offline UI demos without a backend
VITE_ENABLE_API_MOCKS=false
